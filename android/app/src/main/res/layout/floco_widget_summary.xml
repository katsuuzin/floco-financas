<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/floco_widget_bg">
    <TextView android:id="@+id/w_month" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Floco Finanças" android:textColor="#311E0D" android:textSize="12sp" />
    <TextView android:id="@+id/w_balance" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Abra o app" android:textColor="#311E0D" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_flow" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#311E0D" android:textSize="12sp" />
    <TextView android:id="@+id/w_invoice" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#311E0D" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <TextView android:id="@+id/w_add_expense" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
            android:gravity="center" android:text="− Despesa" android:textColor="#FFFFFF" android:textStyle="bold"
            android:background="@drawable/floco_widget_button" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/w_add_income" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
            android:gravity="center" android:text="+ Receita" android:textColor="#FFFFFF" android:textStyle="bold"
            android:background="@drawable/floco_widget_button" />
    </LinearLayout>
</LinearLayout>
